{
  "name": "answeriq-cloudflare",
  "version": "2.0.0",
  "description": "Subjective answer evaluation chatbot on Cloudflare Workers",
  "main": "worker.js",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "tail": "wrangler tail answeriq-chatbot",
    "test": "pwsh -File test-worker.ps1",
    "deploy-all": "pwsh -File deploy.ps1 -All",
    "deploy-backend": "pwsh -File deploy.ps1 -Backend",
    "deploy-frontend": "pwsh -File deploy.ps1 -Frontend"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "education",
    "ai",
    "evaluation",
    "chatbot",
    "tfidf"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
